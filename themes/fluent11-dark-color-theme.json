  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#7d8b7d", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#D0BCFF" } },
    { "scope": ["string", "string.quoted", "punctuation.definition.string"], "settings": { "foreground": "#9FDF9F" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#F5D97E" } },
    { "scope": ["variable", "variable.other.readwrite", "meta.definition.variable"], "settings": { "foreground": "#e6e6e6" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#FFD8A8" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call.generic"], "settings": { "foreground": "#4CC2FF" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"], "settings": { "foreground": "#7EE0D4" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#4CC2FF" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#D0BCFF" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#c5c5c5" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#9d9d9d" } },
    { "scope": ["support.constant.property-value", "constant.other.color"], "settings": { "foreground": "#F5D97E" } },
    { "scope": ["variable.other.property", "support.variable.property"], "settings": { "foreground": "#7ED4FF" } },
    { "scope": ["string.regexp"], "settings": { "foreground": "#7EE0D4" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#4CC2FF", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#9FDF9F" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#4CC2FF" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#FF99A4" } },
    { "scope": ["support.type.property-name.json", "meta.object-literal.key"], "settings": { "foreground": "#7ED4FF" } },
    { "scope": ["keyword.other.unit"], "settings": { "foreground": "#F5D97E" } },
    { "scope": ["entity.name.namespace", "storage.modifier.import", "storage.modifier.package"], "settings": { "foreground": "#7EE0D4" } }
  ],
  "semanticTokenColors": {
    "function": "#4CC2FF",
    "method": "#4CC2FF",
    "class": "#7EE0D4",
    "type": "#7EE0D4",
    "interface": "#7EE0D4",
    "enum": "#7EE0D4",
    "namespace": "#7EE0D4",
    "parameter": "#FFD8A8",
    "property": "#7ED4FF",
    "variable": "#e6e6e6",
    "keyword": "#D0BCFF",
    "string": "#9FDF9F",
    "number": "#F5D97E",
    "comment": { "foreground": "#7d8b7d", "fontStyle": "italic" }
  }
}